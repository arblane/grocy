# MariaDB configuration
MARIADB_ROOT_PASSWORD="change_me_root_password"
MARIADB_DATABASE=grocy_db
MARIADB_USER=grocy
MARIADB_PASSWORD="change_me_grocy_password"

# Volume names
MARIADB_VOLUME=mariadb_data

# Grocy configuration
PUID=1000
PGID=1000
TZ=America/New_York
GROCY_DATABASE_TYPE=mysql
GROCY_DATABASE_HOST=mariadb
GROCY_DATABASE_PORT=3306
GROCY_DATABASE_NAME=grocy_db
GROCY_DATABASE_USER=grocy
GROCY_DATABASE_PASSWORD="change_me_grocy_password"
GROCY_CONFIG_VOLUME=./grocy-config
GROCY_APP_VOLUME=./grocy-app